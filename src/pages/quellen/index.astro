  {
    id: 'testdaf',
    titel: 'TestDaF — offizielles Vorbereitungsmaterial',
    untertitel:
      'Format-Referenz für unser TestDaF-Modul (Lesen 3 Aufgaben, Hören 3 Aufgaben im Originalformat). Unser Modul selbst ist zu 100 % eigenes Material — hier wird nur das Original verlinkt.',
    quellen: [
      {
        institution: 'TestDaF-Institut / g.a.s.t.',
        titel: 'Beispielaufgaben zum digitalen TestDaF',
        url: 'https://www.testdaf.de/de/teilnehmende/der-digitale-testdaf/vorbereitung-auf-den-digitalen-testdaf/beispielaufgaben-zum-digitalen-testdaf/',
        beschreibung:
          'Kostenlose Beispielaufgaben aller Prüfungsteile mit Audio- und Video-Dateien, Transkripten und Lösungen — die offizielle Referenz für Aufgabentypen.',
        tipp: 'TestDaF',
        level: 'B2–C1',
        nutzung:
          'Zum Kennenlernen der Original-Aufgabentypen (Kurzantwort, Aussagen zuordnen, Fehler erkennen) direkt auf der g.a.s.t.-Seite.',
