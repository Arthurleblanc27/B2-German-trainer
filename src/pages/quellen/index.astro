---
import Base from '../../layouts/Base.astro';

const SITE = 'https://b2-trainer.pages.dev';
const STAND = 'Oktober 2026';

type Tipp = 'Lesen' | 'Hören' | 'Lesen + Hören' | 'Grammatik' | 'Wörterbuch' | 'TestDaF';

interface Quelle {
  institution: string;
  titel: string;
  url: string;
  beschreibung: string;
  tipp: Tipp;
  level: string;
  nutzung: string;
  lizenz: string;
}

interface Gruppe {
  id: string;
  titel: string;
  untertitel: string;
  quellen: Quelle[];
}

const gruppen: Gruppe[] = [
  {
    id: 'modelltests',
    titel: 'Offizielle Modelltests',
    untertitel: 'Referenz für Format, Aufgabenzahl und Zeitvorgaben. Nur verlinkt — niemals kopiert.',
    quellen: [
      {
        institution: 'Goethe-Institut',
        titel: 'B2-Modellsatz — Lesen (Übungssatz)',
        url: 'https://bfu.goethe.de/b2_mod_2MX6/lesen.php',
        beschreibung:
          'Offizieller B2-Übungssatz für Leseverstehen mit 5 Teilen, 30 Aufgaben und automatischer Auswertung im Browser.',
        tipp: 'Lesen',
        level: 'B2',
        nutzung: 'Als geführte Übung direkt auf der Goethe-Seite öffnen; dient uns als Formatvorlage.',
        lizenz:
          'Link-out. Aufgaben, Texte und Lösungsschlüssel sind Eigentum des Goethe-Instituts — kein Rehosting, kein Scraping.'
      },
      {
        institution: 'Goethe-Institut',
        titel: 'B2-Modellsatz — Hören (Übungssatz)',
        url: 'https://bfu.goethe.de/b2_mod_2MX6/hoeren.php',
        beschreibung:
          'Offizieller B2-Übungssatz für Hörverstehen mit 4 Teilen, 30 Aufgaben und eingebetteten Audiodateien.',
        tipp: 'Hören',
        level: 'B2',
        nutzung: 'Zum Abgleich von Aufgabenzahl, Hörintervall und Zeitvorgabe; Audio nur dort abspielen.',
        lizenz:
          'Link-out. Die Audioclips liegen auf Servern des Goethe-Instituts — werden nicht heruntergeladen oder gespiegelt.'
      },
      {
        institution: 'Goethe-Institut',
        titel: 'Modellsatz Erwachsene (PDF)',
        url: 'https://www.goethe.de/pro/relaunch/prf/materialien/B2/b2_modellsatz_erwachsene.pdf',
        beschreibung:
          'Der komplette B2-Modellsatz als PDF: Lesen, Hören, Schreiben und Sprechen inklusive Lösungsschlüssel und Transkripten.',
        tipp: 'Lesen + Hören',
        level: 'B2',
        nutzung: 'Referenz für Rubrik und Aufgabenstellung; das PDF direkt beim Goethe-Institut herunterladen.',
        lizenz:
          'Link-out. Das PDF wird nicht in unserem Repository gespeichert oder weiterverbreitet — der Link zeigt auf die Originalquelle.'
      },
      {
        institution: 'telc gGmbH',
        titel: 'telc Deutsch B2 — Übungstest',
        url: 'https://www.telc.net/sprachpruefungen/zertifikatspruefung/deutsch/telc-deutsch-b2/',
        beschreibung:
          'Offizielle telc-Übungstests und Prüfungsinformationen zu telc Deutsch B2 (GER), inklusive kostenlosem Übungstest-ZIP.',
