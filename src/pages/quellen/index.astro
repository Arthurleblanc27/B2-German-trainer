      {
        institution: 'TestDaF-Institut / g.a.s.t.',
        titel: 'Aufbau des digitalen TestDaF',
        url: 'https://www.testdaf.de/de/teilnehmende/der-digitale-testdaf/aufbau-des-digitalen-testdaf/',
        beschreibung:
          'Beschreibung des Prüfungsaufbaus: vier Prüfungsteile, Aufgabenzahl, Zeitvorgaben und Bewertung in TDN-Stufen.',
        tipp: 'TestDaF',
        level: 'B2–C1',
        nutzung:
          'Als Formatvorlage für unser TestDaF-Modul: Lesen 3 Aufgaben (30 Items), Hören 3 Aufgaben (25 Items), TDN-Rückmeldung.',
        lizenz: 'Link-out. Texte und Strukturangaben werden zitiert, nicht kopiert oder gespiegelt.'
      },
      {
        institution: 'TestDaF-Institut / g.a.s.t.',
        titel: 'Tutorials zu allen Aufgabentypen',
        url: 'https://www.testdaf.de/de/teilnehmende/der-digitale-testdaf/vorbereitung-auf-den-digitalen-testdaf/',
        beschreibung:
          'Kurze Tutorial-Videos zu jedem Aufgabentyp in Lesen, Hören, Schreiben und Sprechen — zeigen Bedienung und Erwartung des digitalen Tests.',
        tipp: 'TestDaF',
        level: 'B2–C1',
        nutzung:
          'Zum Abgleich, wie die Originalaufgaben ablaufen, bevor du eine Aufgabe in unserem Modul im Prüfungsmodus übst.',
        lizenz: 'Link-out. Videos liegen auf g.a.s.t.-Servern und werden nicht heruntergeladen oder eingebettet.'
      },
      {
        institution: 'TestDaF-Institut / g.a.s.t.',
        titel: 'Papierbasierter TestDaF — Vorbereitung',
        url: 'https://www.testdaf.de/de/teilnehmende/der-papierbasierte-testdaf/vorbereitung-auf-den-papierbasierten-testdaf/',
        beschreibung:
          'Vorbereitungsangebote für die papierbasierte TestDaF-Version — klassisches Format mit gedruckten Aufgabenheften.',
        tipp: 'TestDaF',
        level: 'B2–C1',
        nutzung: 'Zur Einordnung, wie sich papierbasiertes und digitales Format unterscheiden.',
        lizenz: 'Link-out. Materialien des TestDaF-Instituts werden ausschließlich verlinkt.'
      }
    ]
  },
  {
    id: 'nachrichten',
    titel: 'Nachrichten & Hörtexte',
    untertitel:
      'Echte Hörquellen mit menschlichen Stimmen — für Alltagstempo und Dialekte, die sich synthetisch schwer nachbilden lassen.',
    quellen: [
      {
        institution: 'Deutsche Welle',
        titel: 'Video-Thema',
