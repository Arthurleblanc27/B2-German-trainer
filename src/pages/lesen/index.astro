---
import Base from '../../layouts/Base.astro';
import { unitsVon } from '../../lib/content';
import { TEIL_SPEC } from '../../data/schema';

const units = unitsVon('lesen');
const gesamt = units.reduce((a, u) => a + u.teile.reduce((b, t) => b + t.fragen.length, 0), 0);
const minuten = TEIL_SPEC.lesen.reduce((a, s) => a + s.minuten, 0);
---

<Base
  titel="Leseverstehen"
  skill="lesen"
  beschreibung="Leseverstehen B2 — 5 Teil pro Unit, 30 Aufgaben, fehlerweise Auswertung mit Belegzitat."
>
  <div class="flex flex-col gap-4">
    <section class="seitenkopf">
      <p class="augenbraue">Modul Lesen · Goethe B2</p>
      <h1>Leseverstehen B2</h1>
      <p class="prosa m-0 mt-2">
        Struktur wie im Goethe-Zertifikat B2: Teil 1 Zuordnung (9), Teil 2 Sätze in Lücken (6), Teil 3 Multiple Choice
        (6), Teil 4 Aussagen zu Personen (6), Teil 5 Überschriften (3) — 30 Aufgaben, {minuten} Minuten Bearbeitungszeit.
        Insgesamt {gesamt} Aufgaben im Bank.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class="btn btn-primaer" href={units.length ? `/lesen/${units[0].unit}/` : '/pruefung/'}>
          {units.length ? 'Mit Unit 1 starten' : 'Zum Prüfungsmodus'}
        </a>
        <a class="btn" href="/statistik/">Fortschritt ansehen</a>
      </div>
    </section>

    <ul class="grid list-none grid-cols-1 gap-3 p-0 lg:grid-cols-2">
      {
        units.map((u) => (
          <li class="karte karte-interaktiv flex flex-col gap-2">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="flex items-start gap-2.5">
                <span class="zeile-nr mt-0.5" aria-hidden="true">
                  {u.unit}
                </span>
                <div>
                  <h2 class="m-0 text-lg font-bold">{u.titel}</h2>
                  <p class="ruhig m-0 text-sm">{u.titel_id}</p>
                </div>
              </div>
              <span class="chip chip-akzent">{u.themenfeld}</span>
            </div>
            <p class="m-0 text-sm">{u.beschreibung_id}</p>
            <ul class="m-0 flex flex-wrap list-none gap-1 p-0 text-xs">
              {u.teile.map((t) => (
                <li class="tag">
                  Teil {t.teil}: {t.fragen.length} · {t.zeit_minuten}′
                </li>
              ))}
            </ul>
            <a class="btn btn-primaer mt-1 self-start" href={`/lesen/${u.unit}/`}>
              Unit {u.unit} öffnen →
            </a>
          </li>
        ))
      }
    </ul>

    {units.length === 0 ? <p class="meldung meldung-warn">Noch keine Lesen-Unit vorhanden (src/content/lesen/).</p> : null}

    <section class="karte">
      <h2 class="m-0 text-lg font-bold">Weiterüben bei offiziellen Anbietern</h2>
      <p class="prosa m-0 mt-1 text-sm">
        Diese Seite enthält ausschließlich eigene Texte. Offizielle Modelltests und weitere Übungstexte findest du über
        die <a href="/quellen/">Quellen-Seite</a> — dort sind fremde Materialien nur verlinkt, nie kopiert.
      </p>
    </section>
  </div>
</Base>
