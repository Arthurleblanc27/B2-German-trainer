---
import Base from '../../layouts/Base.astro';
import {
  alleTestdafAufgaben,
  aufgabenDerPruefung,
  alleTestdafPruefungen,
  modelltestNummern,
  pruefungPfad,
  testdafPfad,
  testdafStatistik
} from '../../lib/testdaf-content';
import { TESTDAF_PRUEFUNG, TESTDAF_SPEC, TDN_LABEL, tdnLabel } from '../../data/testdaf';

const stat = testdafStatistik();
const nummern = modelltestNummern();
const pruefungFuer = (n: number) => alleTestdafPruefungen.find((p) => Number(p.modelltest) === Number(n));
const aufgabenFuer = (n: number) =>
  alleTestdafAufgaben
    .filter((a) => Number(a.modelltest) === Number(n))
    .sort((a, b) => (a.bereich === b.bereich ? a.aufgabe - b.aufgabe : a.bereich === 'lesen' ? -1 : 1));
---

<Base
  titel="TestDaF-Modul"
  skill="testdaf"
  beschreibung="TestDaF-Training: Leseverstehen (3 Aufgaben, 30 Items) und Hörverstehen (3 Aufgaben, 25 Items) im Originalformat, mit Audiо und TDN-Rückmeldung."
>
  <div class="flex flex-col gap-4">
    <section class="seitenkopf">
      <p class="augenbraue">TestDaF · Originalformat</p>
      <h1>TestDaF-Modul</h1>
      <p class="prosa m-0 mt-2">
        Zusätzlich zum Goethe-B2-Training (Lesen Teil 1–5, Hören Teil 1–4) enthält der B2-Trainer ein Modul im
        <strong>Originalformat des TestDaF</strong>: drei Aufgaben Leseverstehen und drei Aufgaben Hörverstehen pro
        Modelltest — 30 + 25 Items, mit TDN-Rückmeldung (TDN 3/4/5) je Prüfungsteil.
      </p>
      <p class="prosa m-0 mt-1 text-sm">
        Alle Texte, Transkripte und Aufgaben dieses Moduls sind <strong>eigene Texte</strong> (KI-generiert, manuell
        geprüft). Als Vorbild diente allein das <em>Format</em> des TestDaF (Aufgabenarten, Itemzahlen, Zeiten,
        Schwierigkeitsstufen). Kommerzielle TestDaF-Vorbereitungsbücher sind hier <strong>nicht</strong> kopiert; sie
        stehen auf der <a href="/quellen/">Quellen-Seite</a> als Leseempfehlung.
      </p>
      <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
        <li class="tag">{stat.modelltests} Modelltests</li>
        <li class="tag">{stat.lesen.aufgaben} Lesen-Aufgaben · {stat.lesen.items} Items</li>
        <li class="tag">{stat.hoeren.aufgaben} Hören-Aufgaben · {stat.hoeren.items} Items</li>
        <li class="tag">{stat.glossar} Glossareinträge</li>
      </ul>
    </section>

    <section class="karte">
      <h2 class="m-0 text-lg font-bold">Format im Überblick</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {(['lesen', 'hoeren'] as const).map((bereich) => {
          const p = TESTDAF_PRUEFUNG[bereich];
          return (
            <div class="karte" style={{ background: 'var(--surface-2)' }}>
              <h3 class="m-0 text-base font-bold">
                {bereich === 'lesen' ? 'Leseverstehen' : 'Hörverstehen'} · {p.minuten} Minuten
              </h3>
              <p class="ruhig m-0 text-sm">
                {p.aufgaben} Aufgaben · {p.items} Items · davon {p.uebertragen_minuten}′ zum Übertragen der Lösungen
              </p>
              <table class="mt-2 w-full text-sm">
                <thead>
                  <tr class="text-left">
                    <th class="py-1">Aufgabe</th>
                    <th class="py-1">Items</th>
                    <th class="py-1">Zeit</th>
                    <th class="py-1">Niveau</th>
                  </tr>
                </thead>
                <tbody>
                  {TESTDAF_SPEC[bereich].map((s) => (
                    <tr class="border-t border-[var(--border)]">
                      <td class="py-1">
                        <strong>{s.aufgabe}</strong>
                        <br />
                        <span class="ruhig text-xs">{s.kurz}</span>
                      </td>
                      <td class="py-1">{s.items}</td>
                      <td class="py-1">{s.minuten}′</td>
                      <td class="py-1">{tdnLabel(s.tdn)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="ruhig m-0 mt-2 text-xs">
                {bereich === 'hoeren'
                  ? 'Hörtext 1: einmal hören · Hörtext 2: einmal hören · Hörtext 3: zweimal hören (Angabe je Aufgabe).'
                  : 'Aufgabe 1 Zuordnung (8 Kurztexte A–H + Text I) · Aufgabe 2 Multiple Choice A/B/C · Aufgabe 3 Ja / Nein / „Text sagt dazu nichts“.'}
              </p>
            </div>
          );
        })}
      </div>
      <p class="ruhig m-0 mt-2 text-xs">
        Niveaustufen: {Object.entries(TDN_LABEL)
          .map(([k, v]) => `TDN ${k} — ${v.split('— ')[1] ?? v}`)
          .join(' · ')}
      </p>
    </section>

    {nummern.map((n) => {
      const p = pruefungFuer(n);
      const aufgaben = p ? aufgabenDerPruefung(p) : aufgabenFuer(n);
      const lesen = aufgaben.filter((a) => a.bereich === 'lesen');
      const hoeren = aufgaben.filter((a) => a.bereich === 'hoeren');
      return (
        <section class="karte" data-modelltest={n}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="m-0 text-lg font-bold">
              {p ? p.titel : `Modelltest ${n}`}
            </h2>
            <span class="chip">
              {aufgaben.reduce((s, a) => s + a.fragen.length, 0)} Items · Lesen {lesen.reduce((s, a) => s + a.fragen.length, 0)} ·
              Hören {hoeren.reduce((s, a) => s + a.fragen.length, 0)}
            </span>
          </div>
          {p ? <p class="ruhig m-0 text-sm">{p.titel_id}</p> : null}
          {p ? <p class="prosa m-0 text-sm">{p.beschreibung_id}</p> : null}

          <ul class="m-0 mt-2 grid list-none grid-cols-1 gap-2 p-0 md:grid-cols-2">
            {aufgaben.map((a) => (
              <li class="karte flex flex-col gap-1" style={{ background: 'var(--surface-2)' }}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="m-0 text-base font-bold">
                    {a.bereich === 'lesen' ? 'Leseverstehen' : 'Hörverstehen'} {a.aufgabe}: {a.titel}
                  </h3>
                  <span class="chip">{tdnLabel(a.tdn)}</span>
                </div>
                <p class="ruhig m-0 text-xs">
                  {a.themenfeld} · {a.fragen.length} Items · {a.zeit_minuten}′
                  {a.audio ? ` · ${a.audio.play_limit_pruefung}× hören` : ''}
                </p>
                <p class="m-0 text-sm">{a.beschreibung_id}</p>
                <a class="btn btn-primaer mt-1 self-start" href={testdafPfad(a)}>
                  Aufgabe öffnen
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-3 flex flex-wrap gap-2">
            {p ? (
              <a class="btn btn-primaer" href={pruefungPfad(n)}>
                Modelltest {n} als Prüfung starten (75′)
              </a>
            ) : null}
          </div>
        </section>
      );
    })}

    {nummern.length === 0 ? (
      <p class="meldung meldung-warn">
        Noch keine TestDaF-Aufgaben vorhanden — erwartet werden JSON-Dateien in <code>src/content-testdaf/</code>.
      </p>
    ) : null}

    <section class="karte">
      <h2 class="m-0 text-lg font-bold">Bewertung</h2>
      <p class="prosa m-0 mt-1 text-sm">
        Geschlossene Aufgaben (Zuordnung, Multiple Choice, Richtig/Falsch, Ja/Nein/Text sagt dazu nichts) werden exakt
        bewertet. Offene Aufgaben (Stichworte) werden automatisch vorbewertet — Musterlösungen und Schlüsselwörter
        sind hinterlegt, sinngemäße Antworten kannst du nach Einsicht der Musterlösung selbst als richtig markieren.
      </p>
      <p class="prosa m-0 mt-1 text-sm">
        TDN-Einstufung dieser Simulation: ≥40 % TDN 3 · ≥60 % TDN 4 · ≥80 % TDN 5. Die offizielle Einstufung nimmt
        allein der TestDaF vor. <a href="/testdaf/glossar/">Zum Glossar des Moduls →</a>
      </p>
    </section>
  </div>
</Base>
