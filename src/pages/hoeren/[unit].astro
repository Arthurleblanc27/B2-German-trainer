---
import Base from '../../layouts/Base.astro';
import UnitRunner from '../../components/UnitRunner';
import { unitsVon } from '../../lib/content';

export function getStaticPaths() {
  return unitsVon('hoeren').map((unit) => ({ params: { unit: String(unit.unit) }, props: { unit } }));
}

const { unit } = Astro.props;
---

<Base titel={`Hören ${unit.unit}: ${unit.titel}`} skill="hoeren" beschreibung={`Hörenverstehen B2 — Unit ${unit.unit}: ${unit.titel} (${unit.themenfeld}). 30 Aufgaben mit begrenzter Wiedergabe.`}>
  <UnitRunner client:load unit={unit} />
</Base>
